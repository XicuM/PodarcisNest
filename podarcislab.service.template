[Unit]
Description=PodarcisLab Multi-User Research Hub & Container Orchestrator
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{PYTHON_BIN}} -m podarcislab.cli run --host 0.0.0.0 --port {{PORT}}
Restart=always
RestartSec=5s
Environment=PODARCISLAB_ENV=production
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
