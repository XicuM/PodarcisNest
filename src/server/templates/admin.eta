<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PodarcisNest Admin Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0a0d14;
      --bg-surface: #121826;
      --bg-card: rgba(22, 30, 46, 0.7);
      --accent-cyan: #29b8db;
      --accent-purple: #7c3aed;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-glow: rgba(41, 184, 219, 0.2);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-main);
      min-height: 100vh;
      padding: 30px 20px;
    }
    .container { max-width: 1160px; margin: 0 auto; }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .brand-title {
      font-size: 24px;
      font-weight: 700;
      background: linear-gradient(135deg, #ffffff, var(--accent-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      margin-left: 20px;
      font-size: 14px;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--accent-cyan); }
    .grid-layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 24px;
      margin-bottom: 24px;
    }
    @media (max-width: 900px) { .grid-layout { grid-template-columns: 1fr; } }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-glow);
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      margin-bottom: 24px;
    }
    .card-title {
      font-size: 17px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .form-group { margin-bottom: 14px; }
    .form-group:last-child { margin-bottom: 0; }
    .form-label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .form-input, .form-select {
      width: 100%;
      padding: 9px 12px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      color: #ffffff;
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
    }
    .form-input:focus, .form-select:focus { border-color: var(--accent-cyan); }
    .form-select option {
      background-color: #161e2e;
      color: #ffffff;
    }
    .btn {
      padding: 8px 14px;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-primary { background: var(--accent-cyan); color: #0a0d14; }
    .btn-primary:hover { opacity: 0.9; }
    .btn-secondary { background: rgba(255, 255, 255, 0.1); color: #fff; }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.18); }
    .btn-danger { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.4); }
    .btn-danger:hover { background: rgba(239, 68, 68, 0.3); }
    .btn-success { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.4); }
    .btn-sm { padding: 5px 10px; font-size: 11px; }
    
    .repo-subcard {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 14px;
    }
    .repo-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .repo-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--accent-cyan);
    }
    .inline-controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 5px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-success { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); }
    .badge-warning { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .badge-danger { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }

    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 13px;
    }
    th {
      font-size: 11px;
      text-transform: uppercase;
      color: var(--text-muted);
      background: rgba(0, 0, 0, 0.2);
    }
    .action-btns { display: flex; gap: 6px; }
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--bg-surface);
      border: 1px solid var(--accent-cyan);
      color: #fff;
      padding: 12px 20px;
      border-radius: 8px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.6);
      display: none;
      z-index: 1000;
      font-size: 13px;
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <%
    const cfg = it.config || {};
    const repos = cfg.repositories || {};
    const wikiTarget = repos.wiki || 'local';
    const sourcesTarget = repos.sources || cfg.sources_backend || 'local';
    const sourcesBackend = cfg.sources_backend || 'local';
    const harness = cfg.harness || cfg.backend || 'opencode';
    const qmdEnabled = cfg.engines?.qmd !== false;
    const wikiRepo = it.wikiRepo || {};
    const sourcesRepo = it.sourcesRepo || {};
    const userList = it.users || [];
    const clineCfg = cfg.cline || {};
  %>

  <div class="container">
    <header>
      <div class="brand-title">🦎 PodarcisNest Admin Control Panel</div>
      <div class="nav-links">
        <a href="/login">User Workspaces</a>
        <a href="/logout">Logout</a>
      </div>
    </header>

    <!-- GLOBAL PODARCIS REPOSITORIES & RUNTIME CONFIGURATION -->
    <div class="card">
      <div class="card-title">
        <span>⚙️ Global Podarcis Repositories & Storage Configuration</span>
        <button class="btn btn-primary" onclick="saveGlobalConfiguration()">💾 Save & Apply Server Configuration</button>
      </div>
      <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">
        Configure shared mounts (<code>wiki/</code>, <code>sources/</code>) and execution parameters. All connected user containers inherit these repositories and backend defaults.
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        
        <!-- 1. SHARED WIKI REPO -->
        <div class="repo-subcard">
          <div class="repo-header">
            <div class="repo-name">📖 Shared Wiki Repository (<code>data/shared/wiki</code>)</div>
            <div>
              <% if (wikiRepo.isGitRepo) { %>
                <span class="badge <%= wikiRepo.isDirty ? 'badge-warning' : 'badge-success' %>">
                  <%= wikiRepo.isDirty ? '● Uncommitted' : 'Clean' %>
                </span>
              <% } else { %>
                <span class="badge badge-success">Local Dir</span>
              <% } %>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Mode / Source Target:</label>
            <select id="cfg-wiki-mode" class="form-select" onchange="toggleGitUrl('wiki')">
              <option value="local" <%= (wikiTarget === 'local') ? 'selected' : '' %>>Local Directory (data/shared/wiki)</option>
              <option value="git" <%= (wikiTarget !== 'local') ? 'selected' : '' %>>Git Remote Repository</option>
            </select>
          </div>

          <div class="form-group" id="cfg-wiki-url-row" style="display: <%= (wikiTarget !== 'local') ? 'block' : 'none' %>;">
            <label class="form-label">Git Remote URL:</label>
            <input type="text" id="cfg-wiki-url" class="form-input" value="<%= (wikiTarget !== 'local') ? wikiTarget : '' %>" placeholder="https://github.com/org/podarcis-wiki.git">
          </div>

          <div class="form-group">
            <label class="form-label">Active Branch & Sync:</label>
            <div class="inline-controls">
              <select id="cfg-wiki-branch" class="form-select" style="flex: 1;" onchange="switchRepoBranch('wiki', this.value)">
                <% const wikiBranches = wikiRepo.availableBranches?.length ? wikiRepo.availableBranches : (wikiRepo.branch ? [wikiRepo.branch] : ['master', 'main']); %>
                <% wikiBranches.forEach(function(b) { %>
                  <option value="<%= b %>" <%= b === wikiRepo.branch ? 'selected' : '' %>><%= b %><%= b === wikiRepo.branch ? ' (active)' : '' %></option>
                <% }) %>
              </select>
              <button class="btn btn-secondary btn-sm" onclick="syncRepo('wiki')" title="Pull / Sync latest git changes">⬇️ Sync/Pull</button>
            </div>
          </div>
        </div>

        <!-- 2. SHARED SOURCES REPO -->
        <div class="repo-subcard">
          <div class="repo-header">
            <div class="repo-name">🗄️ Shared Sources Repository (<code>data/shared/sources</code>)</div>
            <div>
              <% if (sourcesRepo.isGitRepo) { %>
                <span class="badge <%= sourcesRepo.isDirty ? 'badge-warning' : 'badge-success' %>">
                  <%= sourcesRepo.isDirty ? '● Uncommitted' : 'Clean' %>
                </span>
              <% } else { %>
                <span class="badge badge-success">Local Dir</span>
              <% } %>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Storage Backend & Ingestion Mode:</label>
            <select id="cfg-sources-mode" class="form-select" onchange="toggleGitUrl('sources')">
              <option value="local" <%= (sourcesBackend === 'local' || sourcesTarget === 'local') ? 'selected' : '' %>>Local Filesystem (data/shared/sources)</option>
              <option value="gdrive" <%= (sourcesBackend === 'gdrive') ? 'selected' : '' %>>Google Drive Ingestion (gdrive)</option>
              <option value="git" <%= (sourcesBackend === 'git' || (!['local', 'gdrive'].includes(sourcesTarget))) ? 'selected' : '' %>>Git Remote Repository</option>
            </select>
          </div>

          <div class="form-group" id="cfg-sources-url-row" style="display: <%= (!['local', 'gdrive'].includes(sourcesTarget)) ? 'block' : 'none' %>;">
            <label class="form-label">Git Remote URL:</label>
            <input type="text" id="cfg-sources-url" class="form-input" value="<%= (!['local', 'gdrive'].includes(sourcesTarget)) ? sourcesTarget : '' %>" placeholder="https://github.com/org/podarcis-sources.git">
          </div>

          <div class="form-group">
            <label class="form-label">Active Branch & Sync:</label>
            <div class="inline-controls">
              <select id="cfg-sources-branch" class="form-select" style="flex: 1;" onchange="switchRepoBranch('sources', this.value)">
                <% const srcBranches = sourcesRepo.availableBranches?.length ? sourcesRepo.availableBranches : (sourcesRepo.branch ? [sourcesRepo.branch] : ['master', 'main']); %>
                <% srcBranches.forEach(function(b) { %>
                  <option value="<%= b %>" <%= b === sourcesRepo.branch ? 'selected' : '' %>><%= b %><%= b === sourcesRepo.branch ? ' (active)' : '' %></option>
                <% }) %>
              </select>
              <button class="btn btn-secondary btn-sm" onclick="syncRepo('sources')" title="Pull / Sync latest git changes">⬇️ Sync/Pull</button>
            </div>
          </div>
        </div>

      </div>

      <!-- 3. CLINE & AI AGENT OPENAI-COMPATIBLE API CONFIGURATION -->
      <div class="repo-subcard" style="margin-top: 18px;">
        <div class="repo-header">
          <div class="repo-name">🤖 Shared Cline & AI Agent API (OpenAI-Compatible)</div>
          <div>
            <span class="badge badge-success">Inherited by All User Workspaces</span>
          </div>
        </div>
        <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 12px; line-height: 1.5;">
          Configure a centralized OpenAI-compatible LLM endpoint (e.g. OpenAI, OpenCode, Ollama, vLLM, DeepSeek, OpenRouter, or LM Studio). This configuration is automatically synchronized into all researcher VS Code Web workspaces (<code>.vscode/settings.json</code>) and container runtime environment variables.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label class="form-label">API Provider Mode:</label>
            <select id="cfg-cline-provider" class="form-select">
              <option value="openai-compatible" <%= (clineCfg.api_provider === 'openai-compatible' || !clineCfg.api_provider) ? 'selected' : '' %>>openai-compatible (Custom OpenAI Endpoint / OpenCode / Ollama / vLLM)</option>
              <option value="openai" <%= (clineCfg.api_provider === 'openai') ? 'selected' : '' %>>openai (Official OpenAI)</option>
              <option value="anthropic" <%= (clineCfg.api_provider === 'anthropic') ? 'selected' : '' %>>anthropic (Anthropic Claude API)</option>
              <option value="openrouter" <%= (clineCfg.api_provider === 'openrouter') ? 'selected' : '' %>>openrouter (OpenRouter Gateway)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Model ID:</label>
            <input type="text" id="cfg-cline-model" class="form-input" value="<%= clineCfg.model_id || '' %>" placeholder="e.g. gpt-4o, claude-3-5-sonnet, deepseek-coder, qwen2.5-coder">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 10px;">
          <div class="form-group">
            <label class="form-label">Base URL (OpenAI-Compatible Endpoint):</label>
            <input type="text" id="cfg-cline-base-url" class="form-input" value="<%= clineCfg.base_url || '' %>" placeholder="e.g. https://api.openai.com/v1 or http://host.docker.internal:11434/v1">
          </div>

          <div class="form-group">
            <label class="form-label">API Key / Token:</label>
            <input type="password" id="cfg-cline-api-key" class="form-input" value="<%= clineCfg.api_key || '' %>" placeholder="sk-...">
          </div>
        </div>
      </div>

      <!-- RUNTIME & ENGINES SECTION -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 14px;">
        <div class="form-group">
          <label class="form-label">Default Agent Harness:</label>
          <select id="cfg-harness" class="form-select">
            <option value="none" <%= (!harness || harness === 'none') ? 'selected' : '' %>>none (No Agent Harness)</option>
            <option value="opencode" <%= (harness === 'opencode') ? 'selected' : '' %>>opencode (OpenCode Agent Harness)</option>
            <option value="claude" <%= (harness === 'claude') ? 'selected' : '' %>>claude (Claude Code Harness)</option>
            <option value="agy" <%= (harness === 'agy') ? 'selected' : '' %>>agy (Antigravity Harness)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Agent Engine Features:</label>
          <div class="checkbox-row" style="margin-top: 8px;">
            <input type="checkbox" id="cfg-qmd" <%= qmdEnabled ? 'checked' : '' %>>
            <label for="cfg-qmd" style="cursor: pointer; color: var(--text-main);">Enable QMD (Quantum Markdown Engine)</label>
          </div>
        </div>
      </div>
    </div>

    <!-- PROVISIONING & USER MANAGEMENT -->
    <div class="grid-layout">
      <!-- Create New User Container Card -->
      <div class="card">
        <h2 class="card-title">➕ Provision Team Workspace</h2>
        <form id="create-user-form">
          <div class="form-group">
            <label class="form-label">Researcher Username</label>
            <input type="text" id="new-username" name="username" class="form-input" placeholder="e.g. charlie" required>
          </div>
          <div class="form-group">
            <label class="form-label">Initial Password</label>
            <input type="password" id="new-password" name="password" class="form-input" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 10px;">Provision Workspace</button>
        </form>
      </div>

      <!-- Quick Server Info -->
      <div class="card">
        <h2 class="card-title">ℹ Server Habitat Topology</h2>
        <p style="color: var(--text-muted); font-size: 13px; line-height: 1.6;">
          PodarcisNest dynamically spins up isolated Docker containers for each researcher, streaming their session directly to VS Code Web while mounting centralized OKF knowledge.
        </p>
        <div style="margin-top: 16px; font-size: 12px; color: var(--text-muted); line-height: 1.8;">
          <div><strong>Shared Wiki Path:</strong> <code><%= wikiRepo.dir || './data/shared/wiki' %></code></div>
          <div><strong>Shared Sources Path:</strong> <code><%= sourcesRepo.dir || './data/shared/sources' %></code></div>
          <div><strong>Base Image:</strong> <code>podarcisnest-user:latest</code></div>
        </div>
      </div>
    </div>

    <!-- Active User Containers Table -->
    <div class="card">
      <h2 class="card-title">🐳 Managed Team Workspaces & Containers</h2>
      <table>
        <thead>
          <tr>
            <th>Researcher</th>
            <th>Container Status</th>
            <th>Port</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (userList && userList.length > 0) { %>
            <% userList.forEach(function(user) { %>
            <tr>
              <td><strong><%= user.username %></strong></td>
              <td><span class="badge <%= (user.status && user.status.includes('Up')) ? 'badge-success' : 'badge-warning' %>"><%= user.status || 'Stopped' %></span></td>
              <td><code><%= user.port || '—' %></code></td>
              <td style="color: var(--text-muted); font-size: 12px;"><%= user.created_at ? user.created_at.split('T')[0] : '—' %></td>
              <td class="action-btns">
                <% if (user.username !== 'admin') { %>
                <button class="btn btn-secondary btn-sm" onclick="restartContainer('<%= user.username %>')">▶ Restart</button>
                <button class="btn btn-secondary btn-sm" onclick="seedUserWorkspace('<%= user.username %>')">🔄 Re-sync</button>
                <button class="btn btn-danger btn-sm" onclick="deleteUser('<%= user.username %>')">Wipe</button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; color: var(--text-muted);">No users registered yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3500);
    }

    function toggleGitUrl(repoId) {
      if (repoId === 'wiki') {
        const val = document.getElementById('cfg-wiki-mode').value;
        document.getElementById('cfg-wiki-url-row').style.display = (val === 'git') ? 'block' : 'none';
      } else {
        const val = document.getElementById('cfg-sources-mode').value;
        document.getElementById('cfg-sources-url-row').style.display = (val === 'git') ? 'block' : 'none';
      }
    }

    async function saveGlobalConfiguration() {
      const wikiMode = document.getElementById('cfg-wiki-mode').value;
      const wikiVal = wikiMode === 'git' ? (document.getElementById('cfg-wiki-url').value.trim() || 'local') : 'local';

      const sourcesMode = document.getElementById('cfg-sources-mode').value;
      let sourcesVal = sourcesMode;
      if (sourcesMode === 'git') {
        sourcesVal = document.getElementById('cfg-sources-url').value.trim() || 'local';
      }

      const harness = document.getElementById('cfg-harness').value;
      const qmd = document.getElementById('cfg-qmd').checked;

      const clineProvider = document.getElementById('cfg-cline-provider')?.value || 'openai-compatible';
      const clineBaseUrl = (document.getElementById('cfg-cline-base-url')?.value || '').trim();
      const clineApiKey = (document.getElementById('cfg-cline-api-key')?.value || '').trim();
      const clineModel = (document.getElementById('cfg-cline-model')?.value || '').trim();

      const payload = {
        repositories: {
          wiki: wikiVal,
          sources: sourcesVal,
          workspace: 'local'
        },
        harness: harness,
        sources_backend: sourcesMode === 'gdrive' ? 'gdrive' : 'local',
        engines: {
          qmd: qmd
        },
        cline: {
          api_provider: clineProvider,
          base_url: clineBaseUrl,
          api_key: clineApiKey,
          model_id: clineModel
        }
      };

      try {
        const res = await fetch('/api/admin/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showToast('✅ Server & Cline configuration saved and synchronized to all workspaces!');
        } else {
          alert(data.error || 'Failed to save configuration');
        }
      } catch (err) {
        alert('Network error saving configuration');
      }
    }

    async function syncRepo(repoId) {
      showToast(`🔄 Pulling / syncing latest changes for ${repoId}...`);
      try {
        const res = await fetch('/api/admin/repos/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ repo: repoId })
        });
        const data = await res.json();
        showToast(data.message || (data.success ? 'Sync completed' : 'Sync failed'));
        if (data.success) {
          setTimeout(() => location.reload(), 1500);
        }
      } catch (err) {
        alert('Failed to sync repository');
      }
    }

    async function switchRepoBranch(repoId, branch) {
      try {
        const res = await fetch('/api/admin/repos/branch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ repo: repoId, branch: branch })
        });
        const data = await res.json();
        showToast(data.message || `Switched ${repoId} branch to ${branch}`);
      } catch (err) {
        alert('Failed to switch branch');
      }
    }

    async function restartContainer(username) {
      showToast(`Restarting container for ${username}...`);
      const res = await fetch('/api/admin/containers/restart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`Container for ${username} is now Up.`);
        setTimeout(() => location.reload(), 1000);
      } else {
        alert(data.error || 'Failed to restart container');
      }
    }

    async function seedUserWorkspace(username) {
      showToast(`Re-syncing workspace for ${username}...`);
      const res = await fetch('/api/admin/users/seed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`Workspace for ${username} re-seeded successfully.`);
      } else {
        alert(data.error || 'Failed to re-seed workspace');
      }
    }

    document.getElementById('create-user-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = document.getElementById('new-username').value.trim();
      const password = document.getElementById('new-password').value;

      const res = await fetch('/api/admin/users/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to create user');
      }
    });

    async function deleteUser(username) {
      if (!confirm(`Delete user container and workspace for ${username}?`)) return;
      const res = await fetch('/api/admin/users/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to delete user');
      }
    }
  </script>
</body>
</html>
