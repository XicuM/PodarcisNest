[Unit]
Description=PodarcisNest Multi-User Research Habitat & Container Orchestrator (TypeScript)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{NODE_BIN}} {{CLI_BIN}} run --host 0.0.0.0 --port {{PORT}}
Restart=always
RestartSec=5s
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
