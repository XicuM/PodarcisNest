[Unit]
Description=PodarcisNest Multi-User Research Habitat & Container Orchestrator
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{PYTHON_BIN}} -m podarcisnest.cli run --host 0.0.0.0 --port {{PORT}}
Restart=always
RestartSec=5s
Environment=PODARCISNEST_ENV=production
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
