[Unit]
Description=PodarcisNest Slack Research Agent Daemon (TypeScript / Socket Mode)
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{NODE_BIN}} {{CLI_BIN}} slack start
Restart=always
RestartSec=10s
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
