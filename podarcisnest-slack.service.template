[Unit]
Description=PodarcisNest Slack Research Agent Daemon (Socket Mode)
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{PYTHON_BIN}} -m podarcisnest.cli slack start
Restart=always
RestartSec=10s
Environment=PODARCISNEST_ENV=production
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
