{
  "name": "podarcisnest",
  "version": "1.0.0",
  "description": "Multi-User LLM Wiki Server Infrastructure in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "podarcisnest": "bin/podarcisnest.js",
    "nest": "bin/podarcisnest.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli/index.ts run",
    "start": "node dist/cli/index.js run",
    "slack": "tsx src/cli/index.ts slack start",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.1",
    "@fastify/secure-session": "^8.1.1",
    "@fastify/static": "^8.1.0",
    "@fastify/view": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@slack/bolt": "^3.21.4",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "eta": "^3.5.0",
    "fastify": "^5.2.1",
    "fs-extra": "^11.3.0",
    "http-proxy": "^1.18.1",
    "openai": "^4.83.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
